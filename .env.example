# ============================================================================
# SHARED (all three services read these)
# ============================================================================

# Neon PostgreSQL connection string (URI format; the .NET API converts it).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used by better-auth to sign session cookies.
BETTER_AUTH_SECRET="any-long-random-string"

# The WEB app's public origin — OAuth callbacks + better-auth origin checks.
ORIGIN="http://localhost:5173"

# ============================================================================
# OPTIONAL — GitHub social login (shown only when both values are set)
# ============================================================================
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================================================
# SERVER-ONLY OVERRIDES for the web app's BFF calls
# (defaults are fine locally: http://localhost:4000 and http://localhost:5080;
#  docker-compose sets them to service names automatically)
# ============================================================================
# AUTH_SERVICE_URL="http://localhost:4000"
# PRIVATE_API_URL="http://localhost:5080"
